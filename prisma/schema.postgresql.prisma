// prisma/schema.postgresql.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id              String   @id @default(cuid())
  formNumber      String   @unique
  effectiveDate   String

  // Requester Information
  reqCompany      String
  reqName         String

  // Recipient Information
  recCompany      String   @default("")
  recDept         String   @default("")
  recLocation     String   @default("")
  recPersonnel    String   @default("")
  recEmpId        String   @default("")
  recTitle        String   @default("")
  recStatus       String   @default("")

  // System & Network
  snAdd           Boolean  @default(false)
  snChange        Boolean  @default(false)
  snTerminate     Boolean  @default(false)
  snLAN           Boolean  @default(false)
  snVPN           Boolean  @default(false)
  snEmail         Boolean  @default(false)
  snFileSharing   Boolean  @default(false)
  snIntranet      Boolean  @default(false)
  snOther         String   @default("")

  // Hardware & Software
  hwAdd           Boolean  @default(false)
  hwChange        Boolean  @default(false)
  hwTerminate     Boolean  @default(false)
  hwPC            Boolean  @default(false)
  hwPrinter       Boolean  @default(false)
  hwNotebook      Boolean  @default(false)
  hwMSOffice      Boolean  @default(false)
  hwAdobe         Boolean  @default(false)
  hwZoom          Boolean  @default(false)
  hwOther         String   @default("")

  // ERP
  erpAdd           Boolean  @default(false)
  erpChange        Boolean  @default(false)
  erpTerminate     Boolean  @default(false)
  erpPronto        Boolean  @default(false)
  erpSmartMining   Boolean  @default(false)
  erpPositionId    String   @default("")
  erpDistrict      String   @default("")
  erpRef           String   @default("")
  erpSignOnId      String   @default("")
  erpGlobalProfile String   @default("")

  // Description
  additionalDesc  String   @default("")
  costCode        String   @default("")
  justification   String   @default("")
  techComment     String   @default("")
  techAD          Boolean  @default(false)
  techAW          Boolean  @default(false)
  techCR          Boolean  @default(false)
  techEM          Boolean  @default(false)
  techIP          Boolean  @default(false)
  techEP          Boolean  @default(false)

  // Signatures
  sigRequester    String   @default("")
  sigSptDept      String   @default("")
  sigDeptMgr      String   @default("")
  sigSrMgr        String   @default("")
  sigHOO          String   @default("")
  sigITAdmin      String   @default("")
  sigMSDIMgr      String   @default("")

  // Admin fields
  status          String   @default("pending")
  priority        String   @default("normal")
  itNotes         String   @default("")
  assignedTo      String   @default("")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@map("requests")
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([reqName])
  @@index([formNumber])
}

model User {
  id              String    @id @default(cuid())
  emailAddrs      String    @unique
  userName        String    @unique
  fullName        String    @default("")
  role            String    @default("admin")
  department      String    @default("")
  titleUser       String    @default("")
  passwordHash    String

  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("users")
  @@index([emailAddrs])
  @@index([userName])
}